#!/bin/bash
#
# Liquid Glass — tests for hooks/liquid-glass.
#
# Run it from anywhere: ./hooks/test-liquid-glass
#
# The hook is the one part of this theme that writes into files the user owns,
# so it is the one part where a bug is not a wrong colour but a lost config.
# Every case below is a property that has to hold rather than an implementation
# detail: your own gtk.css comes back byte-for-byte, and anything ambiguous is
# left alone.
#
# Case 1 is a regression. The shim used to overwrite gtk.css outright.
#
# (The hyprlock cases from the Omarchy 3.x version are gone with the hyprlock
# section itself — Omarchy 4.0 locks with omarchy-shell.)
#
# Runs entirely inside a temporary HOME. Nothing real is touched.

set -u

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SANDBOX=$(mktemp -d)
trap 'rm -rf "$SANDBOX"' EXIT

fail=0
ok()   { printf '  \033[32mok\033[0m   %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=1; }
check(){ [[ $2 == "$3" ]] && ok "$1" || { bad "$1"; printf '        want: %q\n        got:  %q\n' "$3" "$2"; }; }

SHIM4='@import url("../../.local/state/omarchy/current/theme/gtk.css");'
SHIM3='@import url("../../.local/state/omarchy/current/theme/gtk3.css");'

setup() {
  H="$SANDBOX/h$1"; rm -rf "$H"
  mkdir -p "$H/.config/omarchy/themes" "$H/.config/fastfetch" \
           "$H/.config/gtk-4.0" "$H/.config/gtk-3.0"
  cp -r "$REPO" "$H/.config/omarchy/themes/liquid-glass"
}
run() { HOME="$H" XDG_STATE_HOME="$H/.local/state" bash "$REPO/hooks/liquid-glass" "$1"; }

echo
echo "1. a user's own gtk.css survives apply and revert"
setup 1
cat >"$H/.config/gtk-4.0/gtk.css" <<'EOF'
/* my own tweaks */
headerbar { min-height: 32px; }
EOF
before=$(cat "$H/.config/gtk-4.0/gtk.css")
run liquid-glass
check "import is prepended"      "$(head -1 "$H/.config/gtk-4.0/gtk.css")" "$SHIM4"
check "user rules still present" "$(tail -n +2 "$H/.config/gtk-4.0/gtk.css")" "$before"
run some-other-theme
check "revert restores verbatim" "$(cat "$H/.config/gtk-4.0/gtk.css")" "$before"

echo
echo "2. gtk3 shim installed alongside, and removed"
setup 2
run liquid-glass
check "gtk3 shim written" "$(cat "$H/.config/gtk-3.0/gtk.css")" "$SHIM3"
run some-other-theme
check "gtk3 file removed (was ours alone)" "$([[ -e $H/.config/gtk-3.0/gtk.css ]] && echo present || echo gone)" "gone"

echo
echo "3. applying twice does not duplicate the import"
setup 3
run liquid-glass; run liquid-glass; run liquid-glass
check "one import line" "$(grep -c 'omarchy/current/theme/gtk.css' "$H/.config/gtk-4.0/gtk.css")" "1"

echo
echo "4. commented-out import is not mistaken for ours"
setup 4
printf '/* %s */\n' "$SHIM4" >"$H/.config/gtk-4.0/gtk.css"
run liquid-glass
check "real import added anyway" "$(grep -cxF "$SHIM4" "$H/.config/gtk-4.0/gtk.css")" "1"
run some-other-theme
check "comment survives revert"  "$(cat "$H/.config/gtk-4.0/gtk.css")" "/* $SHIM4 */"

echo
[[ $fail -eq 0 ]] && echo "all passed" || echo "FAILURES"
exit $fail
